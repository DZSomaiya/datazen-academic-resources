import numpy as np
import pandas as pd
from numpy.linalg import matrix_rank

x = pd.read_csv("dataset_2.csv").values

print("Rank:",matrix_rank(x))
A1 = x.shape[1]
A2 = matrix_rank(x)
print(A1,A2)
if(A2 == A1):
    print("The matrix is Linearly Independent")
elif(A2 < A1):
    print("The matrix is Linearly Dependent")
